{
  "manifest_version": 3,
  "name": "Azone 商品ID替换助手",
  "version": "1.0.0",
  "description": "在当前 Azone 商品页内直接替换加购区域的商品 ID/JAN，不刷新、不重新加载页面。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.azone-int.co.jp/azonet/item/*"],
  "action": {
    "default_title": "Azone 商品ID替换助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.azone-int.co.jp/azonet/item/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
